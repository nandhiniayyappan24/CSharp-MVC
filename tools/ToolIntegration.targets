<Project>
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    <MvcProjectPath>$(RepoRoot)\src\CSharpMvc\CSharpMvc.csproj</MvcProjectPath>
    <TestProjectPath>$(RepoRoot)\tests\CSharpMvc.Tests\CSharpMvc.Tests.csproj</TestProjectPath>
  </PropertyGroup>
  <Target Name="RunToolIntegration" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'CSharpMvc.Tools'">
    <Message Importance="high" Text="=== Tool integration for net45 ===" />
    <Message Importance="high" Text="[AltCover] Package: tests/CSharpMvc.Tests.csproj -> altcover" />
    <Message Importance="high" Text="[Coverlet] Package: tests/CSharpMvc.Tests.csproj -> coverlet.collector" />
    <Message Importance="high" Text="[NuGet-Audit] Property: NuGetAudit=true in Directory.Build.props" />
    <Message Importance="high" Text="[OpenTelemetry] Code: src/CSharpMvc/Extensions/OpenTelemetryExtensions.cs" />
    <Message Importance="high" Text="[Roslyn] Config: .editorconfig + EnableNETAnalyzers" />
    <Message Importance="high" Text="[Semgrep] Target: src/CSharpMvc/Analysis/SastFixture.cs via tools/semgrep/" />
    <Message Importance="high" Text="[Stryker.NET] Config: tools/Stryker.NET/stryker-config.json -> Services/**/*.cs" />
    <Message Importance="high" Text="[jscpd] Config: tools/jscpd/.jscpd.json -> src/CSharpMvc/Services" />
    <Message Importance="high" Text="[lizard] Target: src/CSharpMvc/Analysis/ComplexitySample.cs via tools/lizard/" />
    <Message Importance="high" Text="[pydriller] Script: tools/pydriller/run_pydriller.py -> repo root" />
    <Message Importance="high" Text="[roslyn-sast] Config: tools/roslyn-sast/.globalconfig -> GlobalAnalyzerConfigFiles" />
  </Target>

  <Target Name="RunTests" DependsOnTargets="Build">
    <PropertyGroup>
      <XunitConsole>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'xunit.runner.console', '2.4.2', 'tools', 'net452', 'xunit.console.exe'))</XunitConsole>
      <TestDll>$([System.IO.Path]::Combine('$(RepoRoot)', 'tests', 'CSharpMvc.Tests', 'bin', '$(Configuration)', 'net45', 'CSharpMvc.Tests.dll'))</TestDll>
    </PropertyGroup>
    <Exec Command="&quot;$(XunitConsole)&quot; &quot;$(TestDll)&quot; -nologo" WorkingDirectory="$(RepoRoot)" />
  </Target>
  <Target Name="RunCoverlet" DependsOnTargets="RunTests">
    <Message Importance="high" Text="Coverlet via dotnet test is unavailable on net45; use RunTests." />
  </Target>
  <Target Name="RunAltCover" DependsOnTargets="RunTests">
    <Message Importance="high" Text="AltCover via dotnet test is unavailable on net45; package referenced for tooling." />
  </Target>
</Project>
